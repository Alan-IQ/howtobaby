{
  "name": "howtobaby",
  "version": "0.8.0",
  "private": true,
  "description": "HowToBaby monorepo \u2014 evidence-to-action parent guidance and utility platform.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=11"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @howtobaby/web dev",
    "gen:theme-css": "node scripts/generate-theme-reference-css.ts",
    "build": "pnpm --filter @howtobaby/web build",
    "build:static": "pnpm --filter @howtobaby/web build:static",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "check:baseline": "node scripts/check-repo-baseline.ts",
    "check:repo-health": "node scripts/check-repo-health.ts",
    "check:theme-boundary": "node scripts/check-theme-boundary.ts",
    "report:licenses": "node scripts/report-licenses.ts",
    "check": "pnpm typecheck && pnpm check:baseline && pnpm check:repo-health && pnpm check:theme-boundary && pnpm report:licenses --strict",
    "validate": "pnpm check && pnpm lint && pnpm test && pnpm build && pnpm build:static",
    "postinstall": "node scripts/generate-theme-reference-css.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
