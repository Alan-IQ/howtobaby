{
  "name": "howtobaby",
  "version": "0.8.0",
  "private": true,
  "description": "HowToBaby monorepo — evidence-to-action parent guidance and utility platform.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm build:knowledge && pnpm --filter @howtobaby/web dev",
    "gen:theme-css": "node scripts/generate-theme-reference-css.ts",
    "build:knowledge": "node scripts/build-knowledge-index.ts && node scripts/build-evidence-index.ts",
    "build": "pnpm build:knowledge && pnpm --filter @howtobaby/web build",
    "build:static": "pnpm build:knowledge && pnpm --filter @howtobaby/web build:static",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test && pnpm test:scripts",
    "test:scripts": "node --test scripts/lib/*.test.ts",
    "check:baseline": "node scripts/check-repo-baseline.ts",
    "check:repo-health": "node scripts/check-repo-health.ts",
    "check:theme-boundary": "node scripts/check-theme-boundary.ts",
    "check:knowledge-determinism": "node scripts/check-knowledge-determinism.ts",
    "validate:knowledge": "node scripts/validate-sources.ts && node scripts/validate-content.ts && node scripts/validate-provenance.ts && node scripts/validate-translations.ts",
    "report:licenses": "node scripts/report-licenses.ts",
    "clean:modules": "node scripts/clean.ts modules",
    "clean:build": "node scripts/clean.ts build",
    "clean:local": "node scripts/clean.ts local",
    "setup:dropbox": "node scripts/setup-dropbox-ignore.ts",
    "check:quality": "pnpm typecheck && pnpm check:baseline && pnpm check:theme-boundary && pnpm validate:knowledge && pnpm report:licenses --strict",
    "check": "pnpm check:quality && pnpm check:repo-health",
    "validate": "pnpm check && pnpm lint && pnpm test && pnpm check:knowledge-determinism && pnpm build && pnpm build:static",
    "postinstall": "node scripts/generate-theme-reference-css.ts"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3"
  }
}
